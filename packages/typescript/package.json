{
  "name": "@boxcompute/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript SDK for the BoxCompute public API",
  "keywords": [
    "boxcompute",
    "sandbox",
    "ai-agent",
    "sdk"
  ],
  "homepage": "https://boxcompute.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boxcompute/sdk.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/boxcompute/sdk/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint --max-warnings 0 src test",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxlint": "^1.80.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
